<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Shared by Common and OutpostFrontier; edit this sheet through VS Property Manager. -->
  <PropertyGroup Label="UserMacros">
    <OutpostFrontierEnableTickProfile>0</OutpostFrontierEnableTickProfile>
    <OutpostFrontierBetaLabel>0</OutpostFrontierBetaLabel>
    <OutpostFrontierWidescreenSupport>1</OutpostFrontierWidescreenSupport>
    <OutpostFrontierDx9Renderer>0</OutpostFrontierDx9Renderer>
    <OutpostFrontierWalkMode>1</OutpostFrontierWalkMode>
  </PropertyGroup>
</Project>