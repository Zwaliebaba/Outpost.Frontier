    <IncludePath>$(IncludePath);$(Dx8SdkDir)\include</IncludePath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- SEH (__try) for the parser cases on which the reference executes a breakpoint. -->
      <ExceptionHandling>Async</ExceptionHandling>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <!-- P1.7: D3DXGetImageInfoFromFileInMemory from the DX8.1 SDK's static d3dx8.lib, linked as
           DX8RENDERER links it (legacy stdio, no libci, no SafeSEH tables). -->
      <AdditionalDependencies>neuroncomponents.lib;Common.lib;NeuronRuntime.lib;Server.lib;d3d8.lib;d3dx8.lib;legacy_stdio_definitions.lib;delayimp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- P2.3: only Oracle.exe sim uses Server.dll, so it is delay-loaded and the other modes
           (the vector suites, dump, catalog) never load it. Every import from it must be a
           function: its one data export, `Server`, is looked up with GetProcAddress
           (oracle_sim.cpp); a data import would fail the link with LNK1194. -->
      <DelayLoadDLLs>Server.dll;%(DelayLoadDLLs)</DelayLoadDLLs>
      <IgnoreSpecificDefaultLibraries>libci.lib;%(IgnoreSpecificDefaultLibraries)</IgnoreSpecificDefaultLibraries>
      <AdditionalLibraryDirectories>$(Dx8SdkDir)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <ImageHasSafeExceptionHandlers>false</ImageHasSafeExceptionHandlers>
    </Link>
  </ItemDefinitionGroup>
