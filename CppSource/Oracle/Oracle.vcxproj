<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Oracle harness (design/migration-plan.md P0.4): a console program that calls the C++
       reference and writes test vectors for the Rust port. Deleted with the C++ in P7.3. -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="DebugASan|Win32">
      <Configuration>DebugASan</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{D7A3C5E1-4B2F-4E60-9A18-3C5B7E9F0A21}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>Oracle</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='DebugASan|Win32'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- SEH (__try) for the parser cases on which the reference executes a breakpoint. -->
      <ExceptionHandling>Async</ExceptionHandling>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalDependencies>neuroncomponents.lib;Common.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="oracle_catalog.cpp" />
    <ClCompile Include="oracle_main.cpp" />
    <ClCompile Include="oracle_math.cpp" />
    <ClCompile Include="oracle_stricmp.cpp" />
    <ClCompile Include="oracle_support.cpp" />
    <!-- Common.dll does not export MsvcrtAtof; the same source is compiled in. -->
    <ClCompile Include="..\Common\msvcrt_atof.cpp" />
    <!-- P1.9: the RemoteCommon codecs and their packet base, compiled in as RemoteClient.dll
         compiles them (its definitions, no /sdl); the two oracle_net_*_codecs.cpp files
         include the RemoteCommon sources so their file-local quantisers can be called. -->
    <ClCompile Include="oracle_net.cpp" />
    <ClCompile Include="oracle_net_packet_codecs.cpp">
      <PreprocessorDefinitions>OUTPOST_SERVER;REMOTECLIENT_EXPORTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <ClCompile Include="oracle_net_server_codecs.cpp">
      <PreprocessorDefinitions>OUTPOST_SERVER;REMOTECLIENT_EXPORTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <ClCompile Include="..\RemoteClient\rpc_client_packets.cpp">
      <PreprocessorDefinitions>OUTPOST_SERVER;REMOTECLIENT_EXPORTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="oracle_support.h" />
    <ClInclude Include="oracle_net_codecs.h" />
    <ClInclude Include="oracle_net_context.h" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\neuroncomponents\neuroncomponents.vcxproj">
      <Project>{8F3A1B20-9C4D-4E5F-A617-B8C9D0E1F203}</Project>
    </ProjectReference>
    <ProjectReference Include="..\Common\Common.vcxproj">
      <Project>{C0A4E8B1-2D5F-4A17-9C36-E8B0D1F2A405}</Project>
    </ProjectReference>
    <!-- x86math.dll exports nothing: built for oracle_math.cpp, which loads it at run time. -->
    <ProjectReference Include="..\x86math\x86math.vcxproj">
      <Project>{C4D8E201-7A3B-4F91-9E56-2B8C0D1A4E77}</Project>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
