<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Oracle harness (design/migration-plan.md P0.4): a console program that calls the C++
       reference and writes test vectors for the Rust port. Deleted with the C++ in P7.3. -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="DebugASan|Win32">
      <Configuration>DebugASan</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{D7A3C5E1-4B2F-4E60-9A18-3C5B7E9F0A21}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>Oracle</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='DebugASan|Win32'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <!-- P1.7: Shading's sources include <d3dx8tex.h>; appended as Shading.vcxproj appends it. -->
    <IncludePath>$(IncludePath);$(Dx8SdkDir)\include</IncludePath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- SEH (__try) for the parser cases on which the reference executes a breakpoint. -->
      <ExceptionHandling>Async</ExceptionHandling>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <!-- P1.7: D3DXGetImageInfoFromFileInMemory from the DX8.1 SDK's static d3dx8.lib, linked as
           DX8RENDERER links it (legacy stdio, no libci, no SafeSEH tables). -->
      <AdditionalDependencies>neuroncomponents.lib;Common.lib;NeuronRuntime.lib;Server.lib;d3d8.lib;d3dx8.lib;legacy_stdio_definitions.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <IgnoreSpecificDefaultLibraries>libci.lib;%(IgnoreSpecificDefaultLibraries)</IgnoreSpecificDefaultLibraries>
      <AdditionalLibraryDirectories>$(Dx8SdkDir)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <ImageHasSafeExceptionHandlers>false</ImageHasSafeExceptionHandlers>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="oracle_catalog.cpp" />
    <ClCompile Include="oracle_main.cpp" />
    <ClCompile Include="oracle_math.cpp" />
    <ClCompile Include="oracle_stricmp.cpp" />
    <ClCompile Include="oracle_support.cpp" />
    <ClCompile Include="oracle_util.cpp" />
    <ClCompile Include="oracle_util_md5.cpp" />
    <ClCompile Include="oracle_util_spline.cpp" />
    <ClCompile Include="oracle_util_timing.cpp" />
    <!-- P1.3: ReadFile.dll's source is compiled into oracle_vfs.cpp, which registers its
         factories through its DllMain; its stricmp import shim is compiled in beside it. -->
    <ClCompile Include="oracle_vfs.cpp" />
    <!-- P1.7: loads SceneRuntime.dll at run time and reads its objects through SceneRuntime.h. -->
    <ClCompile Include="oracle_anim.cpp" />
    <!-- P1.8: the Engine, Hardpoint and Animation components of the same SceneRuntime.dll. -->
    <ClCompile Include="oracle_scene.cpp" />
    <!-- P1.7: particlefx.dll is loaded at run time (it exports nothing); this file only
         includes its private interface header. -->
    <ClCompile Include="oracle_fx_data.cpp" />
    <ClCompile Include="..\ReadFile\NeuronComponentsStricmp.cpp" />
    <!-- Common.dll does not export MsvcrtAtof; the same source is compiled in. -->
    <ClCompile Include="..\Common\msvcrt_atof.cpp" />
    <!-- P1.7: .sur files through Common.dll's PhyArch::LoadSurfaces, which reads
         NeuronRuntime::Data (hence NeuronRuntime.lib). -->
    <ClCompile Include="oracle_sur.cpp" />
    <!-- P1.7: RendComp.dll's sources are compiled into oracle_mesh_data.cpp and
         Deformable2.dll's (with EyeMaterial.cpp) into oracle_mesh_data_dfm.cpp; neither DLL
         exports anything but DllMain. -->
    <ClCompile Include="oracle_mesh_data.cpp" />
    <ClCompile Include="oracle_mesh_data_dfm.cpp" />
    <!-- P1.9: the RemoteCommon codecs and their packet base, compiled in as RemoteClient.dll
         compiles them (its definitions, no /sdl); the two oracle_net_*_codecs.cpp files
         include the RemoteCommon sources so their file-local quantisers can be called. -->
    <ClCompile Include="oracle_net.cpp" />
    <ClCompile Include="oracle_net_packet_codecs.cpp">
      <PreprocessorDefinitions>OUTPOST_SERVER;REMOTECLIENT_EXPORTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <ClCompile Include="oracle_net_server_codecs.cpp">
      <PreprocessorDefinitions>OUTPOST_SERVER;REMOTECLIENT_EXPORTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <ClCompile Include="..\RemoteClient\rpc_client_packets.cpp">
      <PreprocessorDefinitions>OUTPOST_SERVER;REMOTECLIENT_EXPORTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <!-- P1.7: Shading.dll exports nothing; oracle_shading.cpp includes TextureLibrary.cpp and
         oracle_shading_anim.cpp includes MaterialAnimation.cpp (for their file-local functions);
         the other sources but Shading.cpp (DllMain, factories) are compiled beside them. -->
    <ClCompile Include="oracle_shading.cpp" />
    <ClCompile Include="oracle_shading_anim.cpp" />
    <ClCompile Include="..\Shading\Material.cpp" />
    <ClCompile Include="..\Shading\MaterialBatcher.cpp" />
    <ClCompile Include="..\Shading\MaterialLibrary.cpp" />
    <ClCompile Include="..\Shading\MaterialRegex.cpp" />
    <!-- P2.3: Oracle.exe sim, the scenario oracle; links Server.lib (the Server object and the
         pub:: exports it calls) and loads SimClientStub.dll at run time. -->
    <ClCompile Include="oracle_sim.cpp" />
    <ClCompile Include="oracle_sim_spread.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="oracle_support.h" />
    <ClInclude Include="oracle_net_codecs.h" />
    <ClInclude Include="oracle_net_context.h" />
    <ClInclude Include="oracle_sim.h" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\neuroncomponents\neuroncomponents.vcxproj">
      <Project>{8F3A1B20-9C4D-4E5F-A617-B8C9D0E1F203}</Project>
    </ProjectReference>
    <ProjectReference Include="..\Common\Common.vcxproj">
      <Project>{C0A4E8B1-2D5F-4A17-9C36-E8B0D1F2A405}</Project>
    </ProjectReference>
    <ProjectReference Include="..\NeuronRuntime\NeuronRuntime.vcxproj">
      <Project>{9A4B2C31-0D5E-4F60-B728-C9DAE1F20415}</Project>
    </ProjectReference>
    <!-- x86math.dll exports nothing: built for oracle_math.cpp, which loads it at run time. -->
    <ProjectReference Include="..\x86math\x86math.vcxproj">
      <Project>{C4D8E201-7A3B-4F91-9E56-2B8C0D1A4E77}</Project>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <!-- SceneRuntime.dll exports nothing: built for oracle_anim.cpp, which loads it at run time. -->
    <ProjectReference Include="..\SceneRuntime\SceneRuntime.vcxproj">
      <Project>{B4E8A017-3C5D-4F21-9A86-E7D1C0B4A592}</Project>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <!-- particlefx.dll exports nothing: built for oracle_fx_data.cpp, which loads it at run time. -->
    <ProjectReference Include="..\particlefx\particlefx.vcxproj">
      <Project>{B7E4D91A-3C5F-4A82-9E16-F2C8D0A1B405}</Project>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <!-- P2.3: Oracle.exe sim links Server.lib and runs SimClientStub.dll. -->
    <ProjectReference Include="..\Server\Server.vcxproj">
      <Project>{B1C2D3E4-F5A6-7890-BCDE-F12345678901}</Project>
    </ProjectReference>
    <ProjectReference Include="SimClientStub\SimClientStub.vcxproj">
      <Project>{6B2E9F14-8C3D-4A57-B1E2-3D4C5F6A7B80}</Project>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
