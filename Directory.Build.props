<?xml version="1.0" encoding="utf-8"?>
<!-- Properties every project needs before the C++ defaults load: the toolset (v145 with Visual
     Studio 18, v143 with Visual Studio 2022 as on GitHub's runners) and the Windows SDK. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutpostRoot>$(MSBuildThisFileDirectory)</OutpostRoot>
    <OutpostToolset Condition="'$(VisualStudioVersion)' &gt;= '18.0'">v145</OutpostToolset>
    <OutpostToolset Condition="'$(OutpostToolset)' == ''">v143</OutpostToolset>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
</Project>
