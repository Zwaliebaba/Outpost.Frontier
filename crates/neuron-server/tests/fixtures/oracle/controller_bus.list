# The controller_bus suite (work package P3.1, decision record 0006 point 10).
# Read by CppSource/Oracle/oracle_bus.cpp (Oracle.exe neuron-server) and by
# crates/neuron-server/tests/controller_bus.rs; the directive syntax is in
# oracle_bus.cpp's header. Test messages use ids 4096 and up. Every case ends
# with shutdown, so the next one starts with an empty active list; leftover
# timers carry over, as they do in Server.dll.
# Not scripted here, because the C++ is undefined there: a broadcast or a
# targeted send to itself from a constructor that runs outside a walk, and any
# action in a destructor (the Rust-only tests in src/controller/tests.rs cover
# them), nor a zero heartbeat period, whose NaN depends on the host's
# default NaN.

case priority_order
create A NORMAL
create B NORMAL
create C HIGHEST
create D LOWEST
create E NORMAL
create F ABOVE_NORMAL
state
broadcast 4096 1
shutdown
tick 0
state

case create_during_broadcast
on A 4096 * 1 create B HIGHEST
on A 4096 * 1 send B 4097 5
on B ctor * 0 heartbeat self 1
create A NORMAL
broadcast 4096 1
state
broadcast 4096 2
shutdown
tick 0

case create_during_send
on A 4100 * 1 create B LOWEST
on A 4100 * 1 broadcast 4101 2
create A NORMAL
send A 4100 1
state
shutdown
tick 0

case destroy_self_during_broadcast
on A 4096 1 1 destroy self
create A NORMAL
create B NORMAL
broadcast 4096 1
broadcast 4096 2
send A 4097 3
state
tick 0
send A 4097 4
state
shutdown
tick 0

case destroy_twice_and_deferred
on A 4096 * 1 create B NORMAL
on A 4096 * 1 destroy B
on B destroyed * 0 send A 4098 9
create A NORMAL
broadcast 4096 1
state
destroy B
destroy B
destroy ghost
tick 0
state
shutdown
tick 0

case heartbeat 7
create A NORMAL
create B HIGHEST
heartbeat A 1
heartbeat B 0.25
heartbeat ghost 1
state
tick 0.5
tick 0.5
tick 0.5
tick 0.5
on A heartbeat * 1 heartbeat self 0.5
tick 0.75
state
tick 0.1
tick 3
state
shutdown
tick 0

case timers
on A timer 1 1 timer self 9 10 0
on A timer 3 1 send B 4099 3
create A NORMAL
create B NORMAL
timer A 1 2 0.5
timer A 3 4 0.25
timer ghost 5 6 0.1
timer A 7 8 -1
tick 0.3
tick 0.3
tick 0.01
timer all 11 12 0
tick 0.1
shutdown
tick 0

