case nested_depth
on A 4096 1 1 broadcast 4096 2
on B 4096 2 1 send C 4098 3
on C 4098 * 1 broadcast 4099 4
on C 4099 4 1 create D HIGHEST
on D ctor * 0 send A 4100 5
create A HIGHEST
create B NORMAL
create C LOWEST
broadcast 4096 1
state
broadcast 4099 6
shutdown
tick 0

case ctor_fail
on X ctor * 1 heartbeat self 1
on X ctor * 1 fail
create X NORMAL
create Y NORMAL
send X 4096 1
state
shutdown
tick 0

case ctor_actions_deferred 11
on A 4096 * 1 create B NORMAL
on B ctor * 0 heartbeat self 2
on B ctor * 0 timer self 1 0 0.1
on B ctor * 0 send A 4097 1
on B timer * 0 destroy self
create A NORMAL
broadcast 4096 1
state
tick 0.2
tick 0.2
state
shutdown
tick 0

case shutdown_order
on B destroyed C 1 create D NORMAL
on D destroyed * 0 send ghost 4096 7
create A LOWEST
create B HIGHEST
create C NORMAL
state
shutdown
state
tick 0
state
shutdown
tick 0
