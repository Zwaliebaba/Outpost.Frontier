// Hand-made fixture for the resource-script reader (work package P1.6).
#include <windows.h>
#include "ids.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

1 23 "card1.txt"
2 HTML DISCARDABLE "sub\\card2.txt"
3 ICON "missing.ico"
4 RCDATA { 1, 2, "x" }

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    VALUE "Comments", "{ not a block }"
  END
END

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
100 DIALOG 0, 0, 10, 10
STYLE WS_POPUP
CAPTION "STRINGTABLE { 1, ""x"" }"
FONT 8, "MS Sans Serif"
{
   CONTROL "&Yes", 6, BUTTON, BS_DEFPUSHBUTTON, 1, 2, 3, 4
}

6 ACCELERATORS
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
{
	"N", 57600, CONTROL, VIRTKEY
	VK_F6, 57680, VIRTKEY
}

7 MENU
BEGIN
  POPUP "&File"
  BEGIN
    MENUITEM "E&xit", 57665
  END
END

STRINGTABLE
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
{
  0, 	"Object Unknown"
  1 	"no comma"
  IDS_DEFINED, "from #define"
  IDS_BASE + 1, "expression"
  5, "say ""hi"" and \""quote\"""
  6, "a\nb\tc\\d\a\x41\101\q"
  7, "split " "in " L"three\x263a"
  8, "café ’ — ü"
  9, "url http://example.com/*x*/" // a comment after a string
  10, "continued \
line"
  11, ""
  0x20, "hex id"
}

stringtable discardable
begin
  0x21L, L"wide \q dropped"
end

#ifdef NOT_DEFINED
STRINGTABLE { 40, "skipped" }
#else
STRINGTABLE { 41, "else branch" }
#endif
#ifndef RC_INVOKED
STRINGTABLE { 42, "skipped too" }
#endif

#pragma code_page(1252)
STRINGTABLE { 50, "�" }
