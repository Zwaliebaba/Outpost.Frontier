{
  "mode": "host",                        
  "selfTest": false,

  "logging": { "level": "info", "file": "Outpost.log" },
  "universe": { "definition": "GameData/Universe/Frontier.json" },

  // The mesh order is the classId order the renderer draws with: ships from
  // smallest to largest, then the structure. Nothing in the engine knows which
  // is which -- that is the point (ADR-014).
  "content": {
    "meshDirectory":   "GameData/Meshes",
    "shaderDirectory": "GameData/Shaders",
    "meshes": [
      "Interceptor.obj", "Bomber.obj", "Corvette.obj", "Frigate.obj",
      "Hauler.obj", "Miner.obj", "Carrier.obj", "Battleship.obj",
      "Structure.obj"
    ]
  },

  "server": {
    "port": 7777,
    "maxSessions": 8
  },

  "client": {
    "connect":  { "host": "127.0.0.1", "port": 7777 },
    "window":   { "width": 1600, "height": 900, "mode": "windowed" },
    "renderer": { "vsync": true, "msaa": 4, "frameCap": 0 },
    "camera":   { "zoomMetres": 8000, "yawSnapDegrees": 45 },
    "audio":    { "master": 1.0, "world": 1.0, "ui": 0.8, "music": 0.6, "alerts": 1.0, "ambience": 0.7 },
    "ui":       { "scale": 1.0, "palette": "default", "font": "Consolas" }
  }
}
