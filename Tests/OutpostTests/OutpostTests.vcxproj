  <ItemGroup>
    <ClCompile Include="ConfigTests.cpp" />
    <!--
      The subject, compiled into the suite rather than linked from it.

      `Outpost` is an Application, so it cannot be a ProjectReference the way
      every other test project reaches its library. Naming the one file under
      test is the smaller of the two answers. The other is splitting the
      composition root into a static library and a thin `wWinMain`, which is a
      change to the Dependency Map's own layout and wants deciding on its own.

      It compiles here because it depends on nothing but `AppConfig.h`,
      `Json.h`, `Log.h` and the standard library: no Windows, no device, no
      GameLogic. A file added here that does not have that property is the
      signal that the split has become the right answer.
    -->
    <ClCompile Include="..\..\Outpost\AppConfig.cpp" />
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">Create</PrecompiledHeader>
      <PrecompiledHeader Condition="'$(Configuration)|$(Platform)'=='Release|x64'">Create</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>
