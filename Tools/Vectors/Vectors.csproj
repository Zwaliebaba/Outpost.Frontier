<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test vectors for Source/Core (Design/Plan.md 3.1): runs the original's own Fixed64 and
       Checksum code, compiled from the decompiled sources in DecompiledDir (never copied here), and
       writes their results. Build and run through Generate.ps1.

       .NET Framework, not .NET 10: since .NET 9, out-of-range float-to-integer conversions
       saturate, while the game's Mono (x64) gives what cvttsd2si gives, long.MinValue; the .NET
       Framework x64 JIT does the same as Mono. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Outpost.Vectors</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0618;CS0660;CS0661;CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(DecompiledDir)\BBI.Core\BBI.Core.Utility.FixedPoint\Fixed64.cs" Link="Original\Fixed64.cs" />
    <Compile Include="$(DecompiledDir)\BBI.Core\BBI.Core.Utility\Checksum.cs" Link="Original\Checksum.cs" />
  </ItemGroup>

  <Target Name="RequireDecompiledDir" BeforeTargets="CoreCompile" Condition="'$(DecompiledDir)' == ''">
    <Error Text="Build through Tools/Vectors/Generate.ps1, which passes DecompiledDir (local.json)." />
  </Target>
</Project>
